library(plot3D)
# Define the squared error loss function
squared_error <- function(y, y_hat) {
return(0.5 * (y - y_hat)^2)
}
# Define the logistic activation function
logistic <- function(z) {
return(1 / (1 + exp(-z)))
}
# Generate data
x <- seq(-10, 10, length.out = 200)
y <- seq(-10, 10, length.out = 200)
z <- outer(x, y, FUN = function(x, y) squared_error(1, logistic(x + y)))
# Plot the exaggerated loss surface
persp3D(x, y, z, theta = 30, phi = 30, expand = 0.5, col = "lightblue", ticktype = "detailed", xlab = "Weight 1", ylab = "Weight 2", zlab = "Loss")
# Cargar librerías
library(ggplot2)
# Definir el rango de valores para z
z <- seq(-6, 6, length.out = 100)
# Función sigmoide
sigma <- 1 / (1 + exp(-z))
# Función de pérdida MSE para y=1 y y=0
mse_y1 <- (1 - sigma)^2
mse_y0 <- sigma^2
# Función de pérdida de entropía cruzada para y=1 y y=0
cross_entropy_y1 <- -log(sigma)
cross_entropy_y0 <- -log(1 - sigma)
# Crear dataframes para graficar
data_mse <- data.frame(z, mse_y1, mse_y0)
data_ce <- data.frame(z, cross_entropy_y1, cross_entropy_y0)
# Graficar MSE
p1 <- ggplot(data_mse, aes(x = z)) +
geom_line(aes(y = mse_y1, color = "MSE(y=1)")) +
geom_line(aes(y = mse_y0, color = "MSE(y=0)")) +
labs(title = "Mean Squared Error (MSE)", x = "z = w^T x", y = "Loss") +
theme_minimal() +
scale_color_manual(values = c("blue", "red")) +
theme(legend.title = element_blank())
# Graficar Cross-Entropy
p2 <- ggplot(data_ce, aes(x = z)) +
geom_line(aes(y = cross_entropy_y1, color = "CE(y=1)")) +
geom_line(aes(y = cross_entropy_y0, color = "CE(y=0)")) +
labs(title = "Cross-Entropy Loss", x = "z = w^T x", y = "Loss") +
theme_minimal() +
scale_color_manual(values = c("blue", "red")) +
theme(legend.title = element_blank())
# Mostrar ambas gráficas juntas
