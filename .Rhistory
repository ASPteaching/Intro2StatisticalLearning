# Definir un grid de valores de w1 y w2
w1 <- seq(-3, 3, length.out = 50)
w2 <- seq(-3, 3, length.out = 50)
grid <- expand.grid(w1 = w1, w2 = w2)
# Definir una función sigmoide y calcular la pérdida para MSE
sigmoid <- function(z) { 1 / (1 + exp(-z)) }
grid$z <- grid$w1 * 0.5 + grid$w2 * (-0.5)  # Simular una combinación lineal
grid$mse_loss <- (1 - sigmoid(grid$z))^2 + sigmoid(grid$z)^2  # MSE loss
# Definir la pérdida para Cross-Entropy
grid$ce_loss <- -log(sigmoid(grid$z)) - log(1 - sigmoid(grid$z))  # CE loss
# Graficar MSE en el espacio de pesos
p3 <- ggplot(grid, aes(x = w1, y = w2, fill = mse_loss)) +
geom_tile() +
labs(title = "MSE Loss Surface", x = "w1", y = "w2", fill = "Loss") +
theme_minimal() +
scale_fill_viridis_c()
# Graficar Cross-Entropy en el espacio de pesos
p4 <- ggplot(grid, aes(x = w1, y = w2, fill = ce_loss)) +
geom_tile() +
labs(title = "Cross-Entropy Loss Surface", x = "w1", y = "w2", fill = "Loss") +
theme_minimal() +
scale_fill_viridis_c()
# Mostrar todas las gráficas juntas
library(gridExtra)
grid.arrange(p1, p3, p2, p4, ncol = 2)
# Cargar librerías necesarias
library(ggplot2)
library(plotly)
# Definir un rango de valores para w1 y w2
w1 <- seq(-3, 3, length.out = 50)
w2 <- seq(-3, 3, length.out = 50)
grid <- expand.grid(w1 = w1, w2 = w2)
# Definir una función sigmoide
sigmoid <- function(z) { 1 / (1 + exp(-z)) }
# Simular una combinación lineal de los pesos
grid$z <- grid$w1 * 0.5 + grid$w2 * (-0.5)
# Función de pérdida MSE
grid$mse_loss <- (1 - sigmoid(grid$z))^2 + sigmoid(grid$z)^2
# Función de pérdida Cross-Entropy
grid$ce_loss <- -log(sigmoid(grid$z)) - log(1 - sigmoid(grid$z))
# Crear gráfico 3D para MSE
p_mse <- plot_ly(grid, x = ~w1, y = ~w2, z = ~mse_loss, type = "surface") %>%
layout(title = "MSE Loss Surface",
scene = list(xaxis = list(title = "w1"),
yaxis = list(title = "w2"),
zaxis = list(title = "Loss")))
# Crear gráfico 3D para Cross-Entropy
p_ce <- plot_ly(grid, x = ~w1, y = ~w2, z = ~ce_loss, type = "surface") %>%
layout(title = "Cross-Entropy Loss Surface",
scene = list(xaxis = list(title = "w1"),
yaxis = list(title = "w2"),
zaxis = list(title = "Loss")))
# Mostrar gráficos interactivos
p_mse
p_ce
