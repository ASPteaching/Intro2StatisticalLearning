# Definir el rango de valores para z
z <- seq(-6, 6, length.out = 100)
# Función sigmoide
sigma <- 1 / (1 + exp(-z))
# Función de pérdida MSE para y=1 y y=0
mse_y1 <- (1 - sigma)^2
mse_y0 <- sigma^2
# Función de pérdida de entropía cruzada para y=1 y y=0
cross_entropy_y1 <- -log(sigma)
cross_entropy_y0 <- -log(1 - sigma)
# Crear dataframes para graficar
data_mse <- data.frame(z, mse_y1, mse_y0)
data_ce <- data.frame(z, cross_entropy_y1, cross_entropy_y0)
# Graficar MSE en función de z
p1 <- ggplot(data_mse, aes(x = z)) +
geom_line(aes(y = mse_y1, color = "MSE(y=1)")) +
geom_line(aes(y = mse_y0, color = "MSE(y=0)")) +
